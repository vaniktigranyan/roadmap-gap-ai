# GitHub API (personal access token, no scopes needed for public repos)
# Raises rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=your_github_token_here

# OpenAI API key - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Embeddings run locally via sentence-transformers, no API key needed

# ---- Product selection (all optional) ----
# The system is product-agnostic. Default is Orbot; pick any product from the
# catalogue (discovered_projects.json) by its package name:
#ANALYSIS_PACKAGE=org.ppsspp.ppsspp

# Or override everything manually for a product outside the catalogue:
#GITHUB_REPO=owner/repo
#PRODUCT_NAME=My App
#ANALYSIS_SOURCE=sealuzh

# Each product gets its own database (gaps_<slug>.db) automatically.
