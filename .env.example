# GitHub API (personal access token, no scopes needed for public repos)
# Raises rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=your_github_token_here

# OpenAI API key - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Embeddings run locally via sentence-transformers, no API key needed

# Product being analyzed
GITHUB_REPO=guardianproject/orbot-android
HF_REVIEW_PACKAGE=org.torproject.android

# Database path
DATABASE_PATH=gaps.db
